# ==============================================================================
# BUSCAAI — Exemplo de Configuração de Runtime para Produção (Etapa 11.8)
# ==============================================================================
# Perfil de referência inicial por réplica de contêiner:
# - 1 worker Uvicorn (--workers 1) para compartilhar um único modelo E5 em memória
# - Memória recomendada: 4 GB RAM por réplica (delta RSS E5 ~1,2 GB + margem)
# - CPU recomendada: 4-8 vCPUs (avaliar OMP_NUM_THREADS=4 / TORCH_NUM_THREADS=4)
# - startupProbe: tolerar >= 45s para carga do modelo em CPU
# - readinessProbe: HTTP GET /v1/health (retorna 200 somente quando pronto)
# - Proxy reverso TLS: encerrar TLS à frente da API e configurar timeout >= 60s
#
# IMPORTANTE: nunca grave segredos reais neste arquivo nem em imagens Docker.
# Em produção, injete as credenciais exclusivamente via gestor de segredos.
# ==============================================================================

# --- Credenciais Obrigatórias (injetar via Secret Manager / ambiente) ---
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

EBAY_CLIENT_ID=coloque_seu_client_id_aqui
EBAY_CLIENT_SECRET=coloque_seu_client_secret_aqui
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DAILY_QUOTA_LIMIT=5000

# Lista separada por vírgula de chaves B2B para autenticação via header X-API-Key
BUSCAAI_API_KEYS=coloque_sua_chave_aqui

# --- Câmbio Estimado USD -> BRL (atualizar conforme rotina do Runbook) ---
USD_BRL_RATE=5.50
USD_BRL_RATE_UPDATED_AT=2026-11-27
USD_BRL_RATE_SOURCE=env_fixed_rate

# --- Modelo Semântico E5 (pré-carregado no build / diretório local) ---
BUSCAAI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
BUSCAAI_EMBEDDING_BACKEND=sentence_transformers
BUSCAAI_EMBEDDING_BATCH_SIZE=32
BUSCAAI_EMBEDDING_PRELOAD=true
BUSCAAI_EMBEDDING_LOCAL_FILES_ONLY=true
BUSCAAI_EMBEDDING_CACHE_DIR=/opt/buscai/model_cache
BUSCAAI_DEDUP_PROBABLE_THRESHOLD=0.86
BUSCAAI_DEDUP_SIMILAR_THRESHOLD=0.68

# --- Segurança HTTP, Limites e Rate Limiting (escopo por processo) ---
BUSCAAI_MAX_REQUEST_BODY_BYTES=65536
BUSCAAI_RATE_LIMIT_PER_MINUTE=30
BUSCAAI_RATE_LIMIT_WINDOW_SECONDS=60
BUSCAAI_SEARCH_DEFAULT_LIMIT=10
BUSCAAI_SEARCH_MAX_LIMIT=20
BUSCAAI_CHAT_MAX_HISTORY_MESSAGES=12
BUSCAAI_CHAT_MAX_MESSAGE_CHARS=500
BUSCAAI_CHAT_MAX_HISTORY_TOTAL_CHARS=4000

# --- Observabilidade ---
BUSCAAI_LOG_LEVEL=INFO
