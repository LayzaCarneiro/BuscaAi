              "mode": "raw",
              "raw": "{\n  \"message\": \"Prefiro Lenovo e pelo menos 16 GB de RAM.\",\n  \"conversation_history\": [\n    {\"role\": \"user\", \"content\": \"Quero um notebook para estudar até R$ 4.000.\"},\n    {\"role\": \"assistant\", \"content\": \"Busca concluída na categoria notebook com perfil study. Você pode ajustar orçamento, marca, perfil ou especificações.\"}\n  ],\n  \"budget_brl\": 4000,\n  \"profile_id\": \"study\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat"]
            },
            "description": "Mensagem complementar preservando histórico enviado pelo cliente (stateless)."
          }
