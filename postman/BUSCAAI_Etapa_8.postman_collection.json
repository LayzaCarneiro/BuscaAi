      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200 dentro do limite ou 429 com Retry-After ao exceder', function () {",
              "    pm.expect([200, 429]).to.include(pm.response.code);",
              "    if (pm.response.code === 429) {",
              "        pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
              "        const body = pm.response.json();",
              "        pm.expect(body.error.code).to.eql('rate_limit_exceeded');",
              "    }",
              "});"
            ]
