    {
      "name": "Chat Conversacional (Etapa 10)",
      "description": "Requisições stateless para POST /v1/chat utilizando conversation_history enviado pelo cliente em cada turno.",
      "item": [
        {
          "name": "11. Chat — Primeira mensagem",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contrato ChatResponse válido', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(['ok', 'clarification_needed', 'no_results', 'all_rejected']).to.include(body.status);",
                  "    pm.expect(body.assistant_message).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.conversation_context).to.be.an('object');",
                  "    pm.expect(body.request_id).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-API-Key", "value": "{{api_key}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Quero um notebook para estudar até R$ 4.000.\",\n  \"conversation_history\": [],\n  \"profile_id\": \"study\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat"]
            },
            "description": "Primeira mensagem conversacional sem histórico prévio."
          }
        },
        {
          "name": "12. Chat — Mensagem complementar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
