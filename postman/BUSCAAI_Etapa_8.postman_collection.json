            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejeita histórico excessivo com 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.code).to.eql('validation_error');",
                  "    pm.expect(body.error.request_id).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-API-Key", "value": "{{api_key}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Quero um notebook\",\n  \"conversation_history\": [\n    {\"role\": \"user\", \"content\": \"1\"},\n    {\"role\": \"assistant\", \"content\": \"2\"},\n    {\"role\": \"user\", \"content\": \"3\"},\n    {\"role\": \"assistant\", \"content\": \"4\"},\n    {\"role\": \"user\", \"content\": \"5\"},\n    {\"role\": \"assistant\", \"content\": \"6\"},\n    {\"role\": \"user\", \"content\": \"7\"},\n    {\"role\": \"assistant\", \"content\": \"8\"},\n    {\"role\": \"user\", \"content\": \"9\"},\n    {\"role\": \"assistant\", \"content\": \"10\"},\n    {\"role\": \"user\", \"content\": \"11\"},\n    {\"role\": \"assistant\", \"content\": \"12\"},\n    {\"role\": \"user\", \"content\": \"13\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat"]
            },
            "description": "Excede o limite padrão BUSCAAI_CHAT_MAX_HISTORY_MESSAGES=12 retornando HTTP 422."
          }
        },
        {
          "name": "18. Chat — Autenticação inválida (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna 401 ou 503 se auth não configurada', function () {",
                  "    pm.expect([401, 503]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Não vaza segredo na resposta de erro', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('chave_chat_errada_123');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-API-Key", "value": "chave_chat_errada_123"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Quero um notebook Lenovo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat"]
            },
            "description": "Valida rejeição de API Key inválida também em POST /v1/chat."
          }
        }
      ]
    }
  ]
}
