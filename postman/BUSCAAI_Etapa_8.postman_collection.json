{
  "info": {
    "_postman_id": "8e3b9f50-4a12-4c9a-9f88-202611250008",
    "name": "BUSCAAI - Etapa 8 & Etapa 10 (FastAPI + Chat)",
    "description": "Coleção importável para validação dos endpoints GET /v1/health, POST /v1/search (Etapa 8) e POST /v1/chat (Etapa 10) do BUSCAAI. Configure as variáveis base_url e api_key no Postman antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health (GET /v1/health)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 ou 503', function () {",
              "    pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "pm.test('Contém liveness=alive e readiness', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.liveness).to.eql('alive');",
              "    pm.expect(['ready', 'not_ready']).to.include(body.readiness);",
              "    pm.expect(pm.response.headers.has('X-Request-ID')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        },
        "description": "Endpoint público de liveness e readiness. Retorna 200 quando todas as dependências obrigatórias estão prontas ou 503 quando alguma dependência obrigatória está indisponível."
      }
    },
    {
      "name": "2. Busca autenticada válida (POST /v1/search)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Resposta estruturada com request_id', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(['ok', 'clarification_needed', 'no_results', 'all_rejected']).to.include(body.status);",
              "    pm.expect(body.request_id).to.be.a('string').and.not.empty;",
              "    pm.expect(pm.response.headers.has('X-Request-ID')).to.be.true;",
              "    pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"notebook para trabalho 16gb ram ate 4500 reais\",\n  \"budget_brl\": 4500,\n  \"profile_id\": \"best_value\",\n  \"limit\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/search",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "search"
          ]
        },
        "description": "Executa busca autenticada válida com orçamento em BRL, perfil e limite."
      }
    },
